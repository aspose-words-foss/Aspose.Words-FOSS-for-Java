/// <summary>
/// Renders faces and path of shape. Sets material and fill color.
/// </summary>
class OpenGLFacesRenderer
{
    /// <summary>
    /// Constructor for OpenGLFacesRenderer class.
    /// </summary>
    /// <param name="maxX">Maximum value for the X axis.</param>
    /// <param name="maxY">Maximum value for the Y axis.</param>
    /// <param name="dmlPathShadeType">Specifies the shape to follow for a path gradient shade.</param>
    /// <param name="openGLShapeMaterialBuilder">Calculating material for shape in 3d scene and setting his.</param>
    OpenGLFacesRenderer(
        float maxX,
        float maxY,
        /*DmlPathShadeType*/int dmlPathShadeType,
        IOpenGLShapeMaterialBuilder openGLShapeMaterialBuilder)
    {
        mMaxX = maxX;
        mMaxY = maxY;
        mDmlPathShadeType = dmlPathShadeType;
        mShapeMaterialBuilder = openGLShapeMaterialBuilder;
    }

    void renderFill(DrBrush brush, Dr3DVector normal, Dr3DFigure figure, float offsetZ) throws Exception
    {
        renderFill(brush, normal, figure, offsetZ, null, null);
    }

    void renderFill(
        DrBrush brush,
        Dr3DVector normal,
        Dr3DFigure figure,
        float offsetZ,
        Dr3DVector normalPrevios,
        Dr3DVector normalNext) throws Exception
    {
        renderFill(brush, normal, figure, offsetZ, normalPrevios, normalNext, false);
    }

    void renderFillForBevel(
        DrBrush brush,
        Dr3DVector normal,
        Dr3DFigure figure,
        Dr3DVector normalPrevios,
        Dr3DVector normalNext) throws Exception
    {
        renderFill(brush, normal, figure, 0.0f, normalPrevios, normalNext, true);
    }

    void renderPath(DrPen pen, Dr3DVector normal, Dr3DFigure figure, float offsetZ)
    {
        if (pen == null || figure.getCount() == 0)
            return;

        GL.LineWidth(pen.getWidth() / PEN_WIDTH_SCALING_FACTOR);

        if (pen.getBrush() != null && pen.getBrush().getBrushType() == DrBrushType.SOLID)
        {
            // Color conversion, sequence is important.
            float[] faceColor = DrColorUtil.getBgraVector(((DrSolidBrush)pen.getBrush()).getColor());
            GL.Color4(faceColor);
        }

        GL.PolygonMode(MaterialFace.FrontAndBack, PolygonMode.Fill);
        GL.Begin(figure.isClosed() ? PrimitiveType.LineLoop : PrimitiveType.LineStrip);
        GL.Normal3((float)normal.getX(), (float)normal.getY(), (float)normal.getZ());
        for (int i = 0; i < figure.getCount(); i++)
        {
            Dr3DPoint point = figure.get(i);
            GL.Vertex3((float)point.getX(), (float)point.getY(), (float)point.getZ() + offsetZ);
        }

        GL.End();
    }

    void deleteTexture()
    {
        if (mTextureId != 0)
            GL.DeleteTexture(mTextureId);

        GL.Disable(EnableCap.Texture2D);
    }

    private void renderFill(
        DrBrush brush,
        Dr3DVector normal,
        Dr3DFigure figure,
        float offsetZ,
        Dr3DVector normalPrevios,
        Dr3DVector normalNext,
        boolean isBevel) throws Exception
    {
        if (brush == null || figure.getCount() == 0)
            return;

        DrColor fillColor = preparingFaceFill(brush);
        mShapeMaterialBuilder.setMaterial(fillColor);

        GL.PolygonMode(MaterialFace.FrontAndBack, PolygonMode.Fill);
        GL.Begin(PrimitiveType.TriangleFan);

        if (normalPrevios == null && normalNext == null)
            GL.Normal3((float)normal.getX(), (float)normal.getY(), (float)normal.getZ());

        for (int i = 0; i < figure.getCount(); i++)
        {
            Dr3DPoint point = figure.get(i);

            // If we have Previos and Naxt normal, then recalculate normals for points of the current face.
            if (normalPrevios != null && normalNext != null)
            {
                // The first two points border with the previous face.
                if (i == 0 || (!isBevel && i == 1) || (isBevel && i == 3))
                {
                    Dr3DVector newNormal = normalPrevios.add(normal);
                    newNormal.normalize();
                    GL.Normal3((float)newNormal.getX(), (float)newNormal.getY(), (float)newNormal.getZ());
                }

                // The last two points border with the next face.
                if (i == 2 || (!isBevel && i == 3) || (isBevel && i == 1))
                {
                    Dr3DVector newNormal = normal.add(normalNext);
                    newNormal.normalize();
                    GL.Normal3((float)newNormal.getX(), (float)newNormal.getY(), (float)newNormal.getZ());
                }
            }

            if (mTextureId != 0)
                GL.TexCoord2((float)(point.getX() / mMaxX) * mRepeatTextureX, (float)(point.getY() / mMaxY) * mRepeatTextureY);

            GL.Vertex3((float)point.getX(), (float)point.getY(), (float)point.getZ() + offsetZ);
        }

        GL.End();
    }

    /// <summary>
    /// Specifies the color of the material for the shape. 
    /// It prepares the texture for OpenGL if on the input of the DrTextureBrush or DrHatchBrush or DrLinearGradient.
    /// </summary>
    private DrColor preparingFaceFill(DrBrush brush) throws Exception
    {
        if ((brush.getBrushType() == DrBrushType.TEXTURE
            || brush.getBrushType() == DrBrushType.HATCH
            || brush.getBrushType() == DrBrushType.LINEAR_GRADIENT
            || brush.getBrushType() == DrBrushType.PATH_GRADIENT)
            && mTextureId == 0)
        {
            GL.Disable(EnableCap.Blend);
            GL.Enable(EnableCap.Texture2D);

            mTextureId = GL.GenTexture();
            GL.BindTexture(TextureTarget.Texture2D, mTextureId);
            int textureWrapMode = (int)TextureWrapMode.Clamp;
            switch (brush.getBrushType())
            {
                case DrBrushType.HATCH:
                    textureWrapMode = loadTexture((DrHatchBrush)brush);
                    break;

                case DrBrushType.TEXTURE:
                    textureWrapMode = loadTexture((DrTextureBrush)brush);
                    break;

                case DrBrushType.LINEAR_GRADIENT:
                    textureWrapMode = loadTexture((DrLinearGradientBrush)brush);
                    break;

                case DrBrushType.PATH_GRADIENT:
                    textureWrapMode = loadTexture((PathDrGradientBrush)brush);
                    break;
            }

            GL.TexParameter(TextureTarget.Texture2D, TextureParameterName.TextureMinFilter, (int)TextureMinFilter.Nearest);
            GL.TexParameter(TextureTarget.Texture2D, TextureParameterName.TextureMagFilter, (int)TextureMagFilter.Nearest);
            GL.TexParameter(TextureTarget.Texture2D, TextureParameterName.TextureWrapS, textureWrapMode);
            GL.TexParameter(TextureTarget.Texture2D, TextureParameterName.TextureWrapT, textureWrapMode);
        }

        if (brush.getBrushType() == DrBrushType.SOLID)
            return ((DrSolidBrush)brush).getColor();

        return DrColor.WHITE;
    }

    private int loadTexture(DrLinearGradientBrush drLinearGradientBrush) throws Exception
    {
        BitmapPal bitmap = new BitmapPal(BITMAP_WIDTH, BITMAP_HEIGHT);
        try /*JAVA: was using*/
        {
            GraphicsPal graphics = new GraphicsPal(bitmap);
            try /*JAVA: was using*/
            {
                DrMatrix brushRectTransform =
                DrMatrix.createStretchMatrix(drLinearGradientBrush.getRectangle(),
                new RectangleF(0f, 0f, BITMAP_WIDTH, BITMAP_HEIGHT));

                brushRectTransform.multiply(drLinearGradientBrush.getTransform(), MatrixOrder.PREPEND);
                drLinearGradientBrush.setTransform(brushRectTransform);
                graphics.fillRectangle(drLinearGradientBrush, RectangleF.fromRectangle(new Rectangle(0, 0, bitmap.getWidth(), bitmap.getHeight())));
            }
            finally { if (graphics != null) graphics.dispose(); }

            return loadTextureIntoMemory(bitmap, WrapMode.CLAMP);
        }
        finally { if (bitmap != null) bitmap.dispose(); }
    }

    private int loadTexture(PathDrGradientBrush pathDrGradientBrush) throws Exception
    {
        if (mDmlPathShadeType != DmlPathShadeType.CIRCLE)
        {
            DrTextureBrush drTextureBrush = BrushPal.createTextureBrush(pathDrGradientBrush);
            drTextureBrush.setWrapMode(WrapMode.CLAMP);
            return loadTexture(drTextureBrush);
        }

        // Constants -30 and 185 was chosen empirically.
        ApsBoundingBoxCalculator boxCalculator = new ApsBoundingBoxCalculator();
        RectangleF pathBrushRect = boxCalculator.calculate(pathDrGradientBrush.getPath());

        DrMatrix brushRectTransform =
        DrMatrix.createStretchMatrix(pathBrushRect, new RectangleF(-30, -30, 185f, 185f));

        brushRectTransform.multiply(pathDrGradientBrush.getTransform(), MatrixOrder.PREPEND);

        pathDrGradientBrush.setTransform(brushRectTransform);

        BitmapPal bitmap = new BitmapPal(BITMAP_WIDTH, BITMAP_HEIGHT);
        try /*JAVA: was using*/
        {
            GraphicsPal graphics = new GraphicsPal(bitmap);
            try /*JAVA: was using*/
            {
                graphics.fillRectangle(pathDrGradientBrush, RectangleF.fromRectangle(new Rectangle(0, 0, bitmap.getWidth(), bitmap.getHeight())));
            }
            finally { if (graphics != null) graphics.dispose(); }

            return loadTextureIntoMemory(bitmap, WrapMode.CLAMP);
        }
        finally { if (bitmap != null) bitmap.dispose(); }
    }

    private int loadTexture(DrTextureBrush brush) throws Exception
    {
        BitmapPal bmp = new BitmapPal(brush);
        try /*JAVA: was using*/
    	{
            return loadTextureIntoMemory(bmp, brush.getWrapMode());
    	}
        finally { if (bmp != null) bmp.dispose(); }
    }

    private int loadTexture(DrHatchBrush brush) throws Exception
    {
        BitmapPal bitmap = new BitmapPal(BITMAP_WIDTH, BITMAP_HEIGHT);
        try /*JAVA: was using*/
        {
            GraphicsPal graphics = new GraphicsPal(bitmap);
            try /*JAVA: was using*/
            {
                DrHatchBrush hatchBrush = new DrHatchBrush(brush.getHatchStyle(), brush.getForegroundColor(),
                brush.getBackgroundColor());

                graphics.fillRectangle(hatchBrush, RectangleF.fromRectangle(new Rectangle(0, 0, bitmap.getWidth(), bitmap.getHeight())));
            }
            finally { if (graphics != null) graphics.dispose(); }

            return loadTextureIntoMemory(bitmap, WrapMode.TILE);
        }
        finally { if (bitmap != null) bitmap.dispose(); }
    }

    private int loadTextureIntoMemory(BitmapPal bitmap, /*WrapMode*/int wrapMode)
    {
        int textureWrapMode = (int)TextureWrapMode.Clamp;
        // TileFlip modes are not supported at the moment.
        if (wrapMode != WrapMode.CLAMP)
        {
            textureWrapMode = (int)TextureWrapMode.Repeat;
            double maxXPoint = ConvertUtilCore.emuToPoint(mMaxX);
            double maxYPoint = ConvertUtilCore.emuToPoint(mMaxY);
            mRepeatTextureX = (float)ConvertUtilCore.pointToPixelInt(maxXPoint, bitmap.getHorizontalResolution()) / bitmap.getWidth();
            mRepeatTextureY = (float)ConvertUtilCore.pointToPixelInt(maxYPoint, bitmap.getVerticalResolution()) / bitmap.getHeight();
        }

        /*Size*/long newSize = resizeImage(bitmap.getWidth(), bitmap.getHeight());

        if (msSize.getWidth(newSize) == bitmap.getWidth() && msSize.getHeight(newSize) == bitmap.getHeight())
            glLoadTextureIntoMemeory(bitmap);
        else
            BitmapPal resizeBmp = new BitmapPal(bitmap.getNativeBitmap(), newSize);
            try /*JAVA: was using*/
            {
                glLoadTextureIntoMemeory(resizeBmp);
            }
            finally { if (resizeBmp != null) resizeBmp.dispose(); }

        return textureWrapMode;
    }

    private void glLoadTextureIntoMemeory(BitmapPal bitmap)
    {
        BitmapDataPal bmpData = bitmap.lockBits();

        GL.TexImage2D(
            TextureTarget.Texture2D,
            0,
            PixelInternalFormat.Rgba,
            bitmap.getWidth(),
            bitmap.getHeight(),
            0,
            PixelFormat.Rgba,
            PixelType.UnsignedByte,
            bmpData.getArgbData());

        bmpData.unlockBits();
    }

