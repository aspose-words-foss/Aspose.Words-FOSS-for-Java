/// <summary>
/// Renders faces and path of shape. Sets material and fill color.
/// </summary>
class OpenGLFacesRenderer
{
    /// <summary>
    /// Constructor for OpenGLFacesRenderer class.
    /// </summary>
    /// <param name="maxX">Maximum value for the X axis.</param>
    /// <param name="maxY">Maximum value for the Y axis.</param>
    /// <param name="dmlPathShadeType">Specifies the shape to follow for a path gradient shade.</param>
    /// <param name="openGLShapeMaterialBuilder">Calculating material for shape in 3d scene and setting his.</param>
    OpenGLFacesRenderer(
        float maxX,
        float maxY,
        /*DmlPathShadeType*/int dmlPathShadeType,
        IOpenGLShapeMaterialBuilder openGLShapeMaterialBuilder)
    {
        mMaxX = maxX;
        mMaxY = maxY;
        mDmlPathShadeType = dmlPathShadeType;
        mShapeMaterialBuilder = openGLShapeMaterialBuilder;
    }

    void renderFill(DrBrush brush, Dr3DVector normal, Dr3DFigure figure, float offsetZ) throws Exception
    {
        renderFill(brush, normal, figure, offsetZ, null, null);
    }

    void renderFill(
        DrBrush brush,
        Dr3DVector normal,
        Dr3DFigure figure,
        float offsetZ,
        Dr3DVector normalPrevios,
        Dr3DVector normalNext) throws Exception
    {
        if (brush == null || figure.getCount() == 0)
            return;

        DrColor fillColor = preparingFaceFill(brush);
        mShapeMaterialBuilder.setMaterial(fillColor);

        GL.polygonMode(MaterialFace.FRONT_AND_BACK, PolygonMode.FILL);
        GL.begin(PrimitiveType.TRIANGLE_FAN);

        if (normalPrevios == null && normalNext == null)
            GL.normal3((float)normal.getX(), (float)normal.getY(), (float)normal.getZ());

        for (int i = 0; i < figure.getCount(); i++)
        {
            Dr3DPoint point = figure.get(i);

            // If we have Previos and Naxt normal, then recalculate normals for points of the current face.
            if (normalPrevios != null && normalNext != null)
            {
                // The first two points border with the previous face.
                if (i == 0 || i == 1)
                {
                    Dr3DVector newNormal = normalPrevios.add(normal);
                    newNormal.normalize();
                    GL.normal3((float)newNormal.getX(), (float)newNormal.getY(), (float)newNormal.getZ());
                }

                // The last two points border with the next face.
                if (i == 2 || i == 3)
                {
                    Dr3DVector newNormal = normal.add(normalNext);
                    newNormal.normalize();
                    GL.normal3((float)newNormal.getX(), (float)newNormal.getY(), (float)newNormal.getZ());
                }
            }

            if (mTextureId != 0)
                GL.texCoord2((float)(point.getX() / mMaxX) * mRepeatTextureX, (float)(point.getY() / mMaxY) * mRepeatTextureY);

            GL.vertex3((float)point.getX(), (float)point.getY(), (float)point.getZ() + offsetZ);
        }

        GL.end();
    }

    void renderPath(DrPen pen, Dr3DVector normal, Dr3DFigure figure, float offsetZ)
    {
        if (pen == null || figure.getCount() == 0)
            return;

        GL.lineWidth(pen.getWidth() / PEN_WIDTH_SCALING_FACTOR);

        if (pen.getBrush() != null && pen.getBrush().getBrushType() == DrBrushType.SOLID)
        {
            // Color conversion, sequence is important.
            float[] faceColor = DrColorUtil.getBgraVector(((DrSolidBrush)pen.getBrush()).getColor());
            GL.color4(faceColor);
        }

        GL.polygonMode(MaterialFace.FRONT_AND_BACK, PolygonMode.FILL);
        GL.begin(figure.isClosed() ? PrimitiveType.LINE_LOOP : PrimitiveType.LINE_STRIP);
        GL.normal3((float)normal.getX(), (float)normal.getY(), (float)normal.getZ());
        for (int i = 0; i < figure.getCount(); i++)
            GL.vertex3((float)figure.get(i).getX(), (float)figure.get(i).getY(), (float)figure.get(i).getZ() + offsetZ);

        GL.end();
    }

    void deleteTexture()
    {
        if (mTextureId != 0)
            GL.deleteTexture(mTextureId);

        GL.disable(EnableCap.TEXTURE_2_D);
    }

    /// <summary>
    /// Specifies the color of the material for the shape. 
    /// It prepares the texture for OpenGL if on the input of the DrTextureBrush or DrHatchBrush or DrLinearGradient.
    /// </summary>
    private DrColor preparingFaceFill(DrBrush brush) throws Exception
    {
        if ((brush.getBrushType() == DrBrushType.TEXTURE
            || brush.getBrushType() == DrBrushType.HATCH
            || brush.getBrushType() == DrBrushType.LINEAR_GRADIENT
            || brush.getBrushType() == DrBrushType.PATH_GRADIENT)
            && mTextureId == 0)
        {
            GL.disable(EnableCap.BLEND);
            GL.enable(EnableCap.TEXTURE_2_D);

            mTextureId = GL.genTexture();
            GL.bindTexture(TextureTarget.TEXTURE_2_D, mTextureId);
            int textureWrapMode = (int)TextureWrapMode.CLAMP;
            switch (brush.getBrushType())
            {
                case DrBrushType.HATCH:
                    textureWrapMode = loadTexture((DrHatchBrush)brush);
                    break;

                case DrBrushType.TEXTURE:
                    textureWrapMode = loadTexture((DrTextureBrush)brush);
                    break;

                case DrBrushType.LINEAR_GRADIENT:
                    textureWrapMode = loadTexture((DrLinearGradientBrush)brush);
                    break;

                case DrBrushType.PATH_GRADIENT:
                    textureWrapMode = loadTexture((PathDrGradientBrush)brush);
                    break;
            }

            GL.texParameter(TextureTarget.TEXTURE_2_D, TextureParameterName.TEXTURE_MIN_FILTER, (int)TextureMinFilter.NEAREST);
            GL.texParameter(TextureTarget.TEXTURE_2_D, TextureParameterName.TEXTURE_MAG_FILTER, (int)TextureMagFilter.NEAREST);
            GL.texParameter(TextureTarget.TEXTURE_2_D, TextureParameterName.TEXTURE_WRAP_S, textureWrapMode);
            GL.texParameter(TextureTarget.TEXTURE_2_D, TextureParameterName.TEXTURE_WRAP_T, textureWrapMode);
        }

        if (brush.getBrushType() == DrBrushType.SOLID)
            return ((DrSolidBrush)brush).getColor();

        return DrColor.WHITE;
    }

