/// <summary>
/// Calculation of properties material for shape in 3d scene.
/// </summary>
class OpenGLShapeMaterialBuilder implements IOpenGLShapeMaterialBuilder
{
    OpenGLShapeMaterialBuilder(/*DmlPresetMaterialType*/int materialType, boolean isEnableMaterial, IWarningCallback warningCallback)
    {
        mMaterialType = materialType;
        mIsEnableMaterial = isEnableMaterial;
        mWarningCallback = warningCallback;

        addWarnings();
    }
 
    public void setMaterial(DrColor shapeColor)
    {
        // Color conversion, sequence is important.
        float[] faceColor = DrColorUtil.getBgraVector(shapeColor);

        if (mIsEnableMaterial)
        {
            switch (mMaterialType)
            {
                case DmlPresetMaterialType.WARM_MATTE:
                    warmMatte(faceColor);
                    break;
                default:
                    default(faceColor);
                    break;
            }
        }
        else
            GL.Color4(faceColor);
    }

    private void default(float[] baseColor)
    {
        GL.Material(MaterialFace.Front, MaterialParameter.Ambient, baseColor);
        GL.Material(MaterialFace.Front, MaterialParameter.Diffuse, baseColor);
    }

    private void warmMatte(float[] baseColor)
    {
        // Color conversion, sequence is important.
        float[] blackColor = DrColorUtil.getBgraVector(DrColor.BLACK);
        float[] darkGrey = DrColorUtil.getBgraVector(DrColor.DARK_GRAY);

        GL.Material(MaterialFace.Front, MaterialParameter.Specular, darkGrey);
        GL.Material(MaterialFace.Front, MaterialParameter.Shininess, 8.0f);
        GL.Material(MaterialFace.Front, MaterialParameter.Ambient, baseColor);
        GL.Material(MaterialFace.Front, MaterialParameter.Emission, blackColor);
        GL.Material(MaterialFace.Front, MaterialParameter.Diffuse, baseColor);
